# CodeSentinel configuration. Copy to `.env` and adjust. Every value is optional;
# the defaults below are what the application uses when a variable is unset.

# --- Storage ---------------------------------------------------------------
# SQLite file for scans, findings and the threat-intel feed cache.
# CS_DATABASE_URL=sqlite:///./data/codesentinel.db
# CS_DATA_DIR=./data

# --- Web application -------------------------------------------------------
# Allow scanning a path on the server's own disk from the web UI.
# Keep this false on any internet-facing deployment.
CS_ALLOW_LOCAL_PATHS=true
# Scan submissions allowed per client IP per minute.
# CS_RATE_LIMIT_PER_MINUTE=5
# CS_LOG_LEVEL=INFO

# --- Ingestion limits ------------------------------------------------------
# CS_CLONE_TIMEOUT_SECONDS=120
# CS_MAX_REPO_MB=200
# CS_MAX_UPLOAD_MB=50
# CS_HISTORY_MAX_COMMITS=500

# --- Threat intelligence ---------------------------------------------------
# All feeds are public and need no key. Optional GitHub token: only used to
# read the repository size before cloning, which raises the unauthenticated
# GitHub API limit of 60 requests/hour. A fine-grained token with no
# permissions (public repositories, read-only) is enough.
# CS_GITHUB_TOKEN=
# CS_HTTP_TIMEOUT_SECONDS=30

# --- Scoring ---------------------------------------------------------------
# CS_SCORE_NORMALISER=10
# CS_DEFAULT_FAIL_ON=p0
